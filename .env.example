# Financial Intelligence Platform V7 — environment template.
# Copy to .env (gitignored) and fill in. Real environment variables override this file,
# and .streamlit/secrets.toml works too (see .streamlit/secrets.toml.example).
# Never commit real values.

# Required for live SEC data: SEC asks automated clients to identify a contact e-mail.
SEC_CONTACT_EMAIL=you@example.com

# Optional: enables the Gemini assistant. Free key: https://aistudio.google.com/apikey
# Keep billing DISABLED on that Google project so usage stays on the free tier.
GEMINI_API_KEY=

# Optional hardening for public deployments (defaults shown).
# AI_ACCESS_CODE=
# AI_ENABLED=true
# AI_CLIENT_DAILY_LIMIT=5
# AI_GLOBAL_DAILY_LIMIT=100
# AI_GLOBAL_PER_MINUTE=5
# AI_COOLDOWN_SECONDS=20
# AI_TRUST_PROXY_HEADERS=false
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Optional runtime switches
# FIP_OFFLINE=1            # never touch the network (bundled data only)
# FIP_CACHE_DIR=           # override the cache directory

# --- Private error alerts (optional; e-mail goes to the site owner only) ---
# Where alerts are sent, and the sender shown on them.
# ALERT_EMAIL_TO=owner@example.com
# ALERT_EMAIL_FROM=sender@example.com
# Option A — Gmail SMTP: needs a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=sender@example.com
# SMTP_PASSWORD=
# Option B — Resend HTTPS API (recommended on Vercel, where Gmail SMTP connections are refused).
# Used on its own, or automatically as a fallback when SMTP fails. Without a verified domain, sign up to
# Resend with the ALERT_EMAIL_TO address: the shared sender only delivers to the account's own e-mail.
# RESEND_API_KEY=
# RESEND_FROM=Financial Intelligence V7 <onboarding@resend.dev>
# Tuning (defaults shown)
# ALERTS_ENABLED=true
# ALERT_COOLDOWN_MIN=60      # same incident type e-mailed at most once per hour
# ALERT_DAILY_MAX=20         # hard cap on alert e-mails per 24 h

# --- Optional accounts (web app) ---
# Public Supabase project URL and anon key, read by the React build (Vite). Without them the site runs in
# guest mode only. Apply supabase/migrations/*.sql to the project first (owner-only RLS on fi_settings).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
