# Financial Intelligence Platform V7 — environment template.
# Copy to .env (gitignored) and fill in. Real environment variables override this file,
# and .streamlit/secrets.toml works too (see .streamlit/secrets.toml.example).
# Never commit real values.

# Required for live SEC data: SEC asks automated clients to identify a contact e-mail.
SEC_CONTACT_EMAIL=you@example.com

# Optional: enables the Gemini assistant. Free key: https://aistudio.google.com/apikey
# Keep billing DISABLED on that Google project so usage stays on the free tier.
GEMINI_API_KEY=

# Optional hardening for public deployments (defaults shown).
# AI_ACCESS_CODE=
# AI_ENABLED=true
# AI_CLIENT_DAILY_LIMIT=5
# AI_GLOBAL_DAILY_LIMIT=100
# AI_GLOBAL_PER_MINUTE=5
# AI_COOLDOWN_SECONDS=20
# AI_TRUST_PROXY_HEADERS=false
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Optional runtime switches
# FIP_OFFLINE=1            # never touch the network (bundled data only)
# FIP_CACHE_DIR=           # override the cache directory
