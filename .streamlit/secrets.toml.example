# Financial Intelligence Platform V7 — configuration template.
#
# LOCAL:   copy this file to .streamlit/secrets.toml (it is gitignored) and fill in values.
# CLOUD:   paste the same lines into Streamlit Community Cloud → App → Settings → Secrets.
# DESKTOP: put the same lines in %LOCALAPPDATA%\FinancialIntelligenceV7\config.toml
#
# Never commit real values. Environment variables with the same names take precedence.

# Required for live SEC data: SEC asks automated users to identify themselves.
SEC_CONTACT_EMAIL = "you@example.com"

# Optional: enables the AI Research Assistant. Create a free key at https://aistudio.google.com/apikey
# Keep billing DISABLED on that Google project so usage stays on the free tier.
GEMINI_API_KEY = "replace-with-your-key"

# Optional hardening for public deployments (defaults shown).
# AI_ACCESS_CODE = "share-this-code-only-with-invited-visitors"
# AI_ENABLED = true
# AI_CLIENT_DAILY_LIMIT = 5        # questions per visitor per rolling 24 h
# AI_GLOBAL_DAILY_LIMIT = 100      # questions per site per rolling 24 h
# AI_GLOBAL_PER_MINUTE = 5
# AI_COOLDOWN_SECONDS = 20
# AI_TRUST_PROXY_HEADERS = false   # only true behind a reverse proxy that sets X-Forwarded-For
# GEMINI_MODELS = "gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite"  # free-tier allowlist only
